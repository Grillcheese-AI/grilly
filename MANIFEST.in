# Include documentation
include README.md
include LICENSE
include CHANGELOG.md
include CLAUDE.md

# Include all shader files
recursive-include shaders *.glsl
recursive-include shaders *.comp
recursive-include shaders *.spv

# Include configuration files
include pyproject.toml

# Exclude development files
exclude .gitignore
exclude .git*
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .pytest_cache
recursive-exclude * .venv
recursive-exclude * .mypy_cache
recursive-exclude * .ruff_cache

# Keep package directories used by setuptools package mapping.
